# Database Connection
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/ai_interview_prep?retryWrites=true&w=majority

# Application Server
PORT=5000
NODE_ENV=development
JWT_SECRET=super-secret-jwt-key-trao-prep-kit-2026

# LLM Provider Configuration
# Supported providers: gemini, groq, mock
LLM_PROVIDER=gemini

# Google Gemini API Key (get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Groq API Key (alternative provider, get from https://console.groq.com/)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Rate Limiter Settings
LLM_RPM_LIMIT=15
LLM_RETRY_MAX_ATTEMPTS=5
LLM_RETRY_BASE_DELAY_MS=2000

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000
