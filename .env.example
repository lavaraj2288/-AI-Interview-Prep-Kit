# ===================================================
# The AI Interview Prep Kit - Environment Configuration
# ===================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# LLM Provider (Google Gemini)
# Obtain a free key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Optional Alternative LLM Providers (OpenAI, OpenRouter, Groq)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Database (MongoDB)
# If left unset or unreachable, the system automatically falls back to the in-memory/JSON store
MONGODB_URI=mongodb://localhost:27017/interview-prep-kit

# Security & Sessions
JWT_SECRET=super-secret-interview-kit-jwt-key-2026
SESSION_EXPIRY=7d

# Web Crawler & Security
# Set to 'true' in development or evaluate testing to permit fetching localhost addresses like http://localhost:8099
ALLOW_LOCAL_URLS=true
CRAWLER_TIMEOUT_MS=8000
CRAWLER_MAX_PAGES=5
CRAWLER_MAX_PAGE_SIZE_KB=1024

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000
